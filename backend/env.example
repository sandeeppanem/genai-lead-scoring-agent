# Anthropic API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ENABLE_LLM_EXPLANATIONS=false

# LeadFlow semantic decisions (demo, gateway, or live)
# demo requires no key and never reports decisions as live Jev output.
TYPESAFE_MODE=demo
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY=
TYPESAFE_TIMEOUT_SECONDS=12
TYPESAFE_MAX_RETRIES=2

# Recommended live path while direct TypeSafe access is waitlisted.
# Put AI_GATEWAY_API_KEY and the same JEV_ADAPTER_TOKEN on Vercel only.
# Put this adapter URL and JEV_ADAPTER_TOKEN on the FastAPI/Render service.
JEV_GATEWAY_ADAPTER_URL=https://genai-lead-scoring-agent.vercel.app/api/jev
JEV_ADAPTER_TOKEN=replace-with-a-long-random-server-to-server-secret
LEADFLOW_CONFIDENCE_THRESHOLD=0.55
LEADFLOW_DB_PATH=
PUBLIC_WRITE_RATE_LIMIT=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEX=^(?:http://(?:localhost|127\.0\.0\.1):[0-9]+|https://genai-lead-scoring-agent(?:-[a-z0-9-]+)?\.vercel\.app)$

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
